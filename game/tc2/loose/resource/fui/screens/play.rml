<rml>
<!-- Modes: pick what the play button queues for, and which maps. -->
<head>
	<title>Play</title>
	<link type="text/rcss" href="../style/base.rcss"/>
	<link type="text/rcss" href="../style/play.rcss"/>
</head>
<body>
<div class="root" data-model="fr" data-class-world="app.world">
	<div class="world-standin" data-if="app.preview"></div>
	<div class="dim-all"></div>
	<div class="screen">
		<h1 class="shadow page-title">#fui_choose_mode</h1>
		<div id="modes">
			<div class="mode rise" data-for="m : modes"
				data-class-selected="m.id == ui.mode" data-class-off="!m.enabled"
				data-event-click="cmd('select_mode', m.id)">
				<div class="mode-art" data-style-decorator="'image(tex:' + m.image + ' cover center top)'"></div>
				<div class="mode-shade"></div>
				<div class="mode-tag chip gold" data-if="m.tag != ''">{{ m.tag | t }}</div>
				<div class="mode-text">
					<div class="title mode-title outline">{{ m.name | t }}</div>
					<div class="mode-desc">{{ m.desc | t }}</div>
					<div class="row mode-meta">
						<span class="chip" data-if="m.size != ''">{{ m.size }}</span>
						<div class="spacer"></div>
						<span class="dim small" data-if="m.players > 0"><span class="live"></span>{{ m.players | thousands }} #fui_players_now</span>
					</div>
				</div>
			</div>
		</div>

		<div id="regions" class="row" data-if="region.list.size > 0">
			<span class="regions-title">#fui_region</span>
			<div class="region chip" data-for="r : region.list" data-class-on="r.on" data-class-bad="r.measured && !r.ok"
				data-event-click="cmd('set_region', r.id)">
				<span data-if="r.id == 'auto'">#fui_region_auto</span>
				<span data-if="r.id != 'auto'">{{ r.name }}</span>
				<span class="region-ms" data-if="r.id != 'auto' && r.measured && r.ms >= 0">{{ r.ms }} #fui_ms</span>
				<span class="region-ms" data-if="r.id != 'auto' && r.measured && !r.ok && r.ms < 0">#fui_region_unreachable</span>
			</div>
		</div>
		<div class="small regions-hint bad" data-if="region.none_ok">{{ 'fui_region_none_ok' | t(region.max_ms) }}</div>
		<div class="dimmer small regions-hint" data-if="region.list.size > 0 && !region.none_ok">#fui_region_hint</div>

		<!-- The casual map pool, as TF2's casual panel had it: maps grouped by
		     game mode, a whole mode ticked at once, and beside every map who
		     is searching for it and who plays it right now. -->
		<div id="pool" class="panel" data-if="ui.mode == 'casual'" data-class-locked="!pool.edit">
			<div class="row pool-head">
				<div class="panel-title grow pool-title">#fui_map_pool</div>
				<span class="pool-n" data-if="pool.n > 0">{{ pool.n_on }}/{{ pool.n }}</span>
			</div>
			<div class="row pool-tools">
				<span class="small pool-live" data-if="pool.counts"><span class="live" data-class-off="pool.queued == 0"></span>{{ 'fui_pool_queued_total' | t(pool.queued) }}</span>
				<div class="spacer"></div>
				<div class="pool-btn" sfx="" data-if="pool.edit && pool.n > 0" data-event-click="cmd('pool_all')">#fui_pool_all</div>
				<div class="pool-btn" sfx="" data-if="pool.edit && pool.n > 0" data-event-click="cmd('pool_none')">#fui_pool_none</div>
			</div>
			<div class="pool-note small" data-if="!pool.edit">#fui_pool_leader</div>
			<div id="pool-list">
				<div class="pool-cat" data-for="c : pool.cats">
					<div class="cat-row" sfx="" data-class-on="c.on" data-class-some="c.some" data-event-click="cmd('toggle_mode_maps', c.id)">
						<div class="box"><div class="tick" data-if="c.on"></div><div class="dash" data-if="c.some"></div></div>
						<span class="cat-name">{{ c.name }}</span>
						<span class="cat-n">{{ c.n_on }}/{{ c.n }}</span>
						<div class="spacer"></div>
						<span class="pill play" data-if="pool.counts && c.playing > 0">{{ 'fui_pool_playing' | t(c.playing) }}</span>
					</div>
					<div class="map-row" sfx="" data-for="map : c.maps" data-class-on="map.on" data-event-click="cmd('toggle_map', map.id)">
						<div class="box"><div class="tick" data-if="map.on"></div></div>
						<div class="map-thumb" data-style-decorator="'image(tex:' + map.image + ' cover center)'"></div>
						<span class="map-name">{{ map.name }}</span>
						<div class="spacer"></div>
						<span class="pill queue" data-if="pool.counts && map.queued > 0">{{ 'fui_pool_searching' | t(map.queued) }}</span>
						<span class="pill play" data-if="pool.counts && map.playing > 0">{{ 'fui_pool_playing' | t(map.playing) }}</span>
						<span class="pill empty" data-if="pool.counts && map.queued == 0 && map.playing == 0">#fui_pool_empty</span>
					</div>
				</div>
				<div class="dim small pool-none" data-if="pool.n == 0">#fui_pool_loading</div>
			</div>
			<div class="small pool-foot gold" data-if="pool.n > 0 && pool.n_on == 0">#fui_pool_any</div>
			<div class="tiny pool-foot dimmer" data-if="pool.n_on > 0">#fui_map_pool_hint</div>
		</div>
	</div>
</div>
</body>
</rml>
