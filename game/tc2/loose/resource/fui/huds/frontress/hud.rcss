/* The Frontress HUD. Laid out on the 1920 x 1080 dp design, like the menus. */

body#hud { pointer-events: none; }
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* Panels lean, like the play button: a skewed plate behind straight text. */
/* A transform makes the plate its own layer: keep it under its siblings. */
#vitals, .arms-card { z-index: 1; }
.vitals-bg, .arms-bg {
	z-index: -1;
	position: absolute; left: 0; top: 0; right: 0; bottom: 0;
	border-radius: 10dp;
	transform: skewX(-8deg);
	decorator: linear-gradient(to bottom, #2a1f19e6, #120d0bf0);
	border: 1dp #6a544288;
	border-bottom: 4dp #c8413b;
}
.team-blu .vitals-bg, .team-blu .arms-bg { border-bottom-color: #4a7fae; }

/* ------------------------------------------------------------ health */
#vitals {
	position: absolute;
	left: 48dp; bottom: 40dp;
	width: 400dp; height: 112dp;
	padding: 0 26dp 0 10dp;
	align-items: center;
}
.portrait { width: 104dp; height: 104dp; margin: -20dp 10dp 0 0; }
.hp-row { align-items: baseline; }
.hp-cross { font-family: "TF2 Build"; font-size: 38dp; color: #8fd16a; margin-right: 8dp; }
.hp-num {
	font-family: "TF2 Build";
	font-size: 70dp;
	line-height: 70dp;
	color: #fff4e8;
	font-effect: shadow(3dp 3dp #000000aa);
}
.hp-max { font-size: 20dp; color: #b8ab92; margin-left: 8dp; }
.hp-bar {
	position: relative;
	height: 12dp;
	margin-top: 4dp;
	border-radius: 6dp;
	background-color: #00000099;
	border: 1dp #ffffff18;
}
.hp-fill {
	position: absolute; left: 0; top: 0; bottom: 0;
	border-radius: 6dp;
	decorator: linear-gradient(to right, #5f9a3a, #a8e07a);
	transition: width 0.2s cubic-out;
}
.hp-over {
	position: absolute; left: 0; top: -3dp; bottom: -3dp;
	border-radius: 7dp;
	background-color: #9fd8ffaa;
	transition: width 0.2s cubic-out;
}
#vitals.over .hp-num { color: #bfe6ff; }
#vitals.low .hp-num { color: #ff6a5a; animation: 0.5s sine-in-out infinite alternate hp-throb; }
#vitals.low .hp-fill { decorator: linear-gradient(to right, #8e2a26, #ef5a4c); }
#vitals.low .hp-cross { color: #ef5a4c; }
@keyframes hp-throb { from { opacity: 1; } to { opacity: 0.55; } }

/* ------------------------------------------------------------ weapon */
#arms { position: absolute; right: 48dp; bottom: 40dp; width: 440dp; }
.arms-card { position: relative; height: 112dp; padding: 0 26dp 0 18dp; align-items: center; }
.weapon-icon { height: 92dp; margin-right: 12dp; }
.ammo-col { align-items: flex-end; text-align: right; }
.weapon-name {
	font-family: "TF2 Build";
	font-size: 16dp;
	color: #d8cdb4;
	text-transform: uppercase;
	white-space: nowrap;
}
.ammo-row { align-items: baseline; justify-content: flex-end; }
.clip {
	font-family: "TF2 Build";
	font-size: 64dp;
	line-height: 66dp;
	color: #fff4e8;
	font-effect: shadow(3dp 3dp #000000aa);
}
.reserve { font-family: "TF2 Build"; font-size: 26dp; color: #b8ab92; margin-left: 10dp; }
.ammo-row.low .clip { color: #ff6a5a; animation: 0.5s sine-in-out infinite alternate hp-throb; }
.clip-bar { width: 180dp; height: 6dp; margin-top: 4dp; border-radius: 3dp; background-color: #00000099; }
.clip-fill { height: 100%; border-radius: 3dp; background-color: #ffc93c; transition: width 0.12s; }

/* A medic's ÜberCharge, over the weapon. */
#uber {
	margin: 0 6dp 10dp 60dp;
	padding: 10dp 16dp 12dp 16dp;
	border-radius: 10dp;
	background-color: #120d0bd8;
	border: 1dp #6a544288;
}
.uber-label { font-family: "TF2 Build"; font-size: 18dp; color: #d8cdb4; text-transform: uppercase; }
.uber-pct { font-family: "TF2 Build"; font-size: 24dp; color: #fff4e8; }
.uber-bar { height: 14dp; margin-top: 6dp; border-radius: 7dp; background-color: #00000099; border: 1dp #ffffff18; }
.uber-fill { height: 100%; border-radius: 7dp; decorator: linear-gradient(to right, #8e2a26, #ef6a5c); transition: width 0.25s; }
.team-blu .uber-fill { decorator: linear-gradient(to right, #2f5679, #6aa2d8); }
#uber.ready { border-color: #ffc93c; }
#uber.ready .uber-pct { color: #ffc93c; animation: 0.6s sine-in-out infinite alternate hp-throb; }
#uber.ready .uber-fill { decorator: linear-gradient(to right, #ffb623, #fff09a); }

/* ------------------------------------------------------------ the match */
#match { position: absolute; left: 0; right: 0; top: 18dp; }
#scorebar { justify-content: center; }
.team-score {
	width: 92dp; height: 62dp;
	text-align: center;
	font-family: "TF2 Build";
	font-size: 42dp;
	line-height: 62dp;
	color: #fff4e8;
	font-effect: shadow(2dp 2dp #00000088);
}
.blu-side { decorator: linear-gradient(to right, #23415c, #4a7fae); border-radius: 12dp 0 0 12dp; }
.red-side { decorator: linear-gradient(to right, #d6463d, #6e1f1b); border-radius: 0 12dp 12dp 0; }
.clock {
	width: 170dp; height: 62dp;
	text-align: center;
	background-color: #120d0be8;
	border-top: 1dp #6a5442;
}
.clock-time { font-family: "TF2 Build"; font-size: 40dp; line-height: 46dp; color: #fff4e8; }
.clock.hurry .clock-time { color: #ff6a5a; }
.clock-note { font-size: 13dp; line-height: 14dp; color: #ffc93c; text-transform: uppercase; }
.clock-note.hot { color: #ff6a5a; animation: 0.5s sine-in-out infinite alternate hp-throb; }

#points { justify-content: center; margin-top: 8dp; gap: 8dp; align-items: center; }
.cp { position: relative; width: 44dp; height: 44dp; }
.cp-disc {
	width: 38dp; height: 38dp;
	margin: 3dp;
	border-radius: 19dp;
	background-color: #8a7d68;
	border: 3dp #120d0a;
	text-align: center;
	font-family: "TF2 Build";
	font-size: 18dp;
	line-height: 32dp;
	color: #fff4e8;
	font-effect: shadow(1dp 1dp #00000088);
}
.cp.red .cp-disc { decorator: radial-gradient(circle farthest-side at 50% 35%, #e2564d, #8e2a26); }
.cp.blu .cp-disc { decorator: radial-gradient(circle farthest-side at 50% 35%, #6aa2d8, #2f5679); }
.cp.locked .cp-disc { opacity: 0.4; }
.cp.capping .cp-disc { border-color: #ffc93c; animation: 0.6s sine-in-out infinite alternate cp-pulse; }
@keyframes cp-pulse { from { transform: scale(1); } to { transform: scale(1.12); } }
.cp-cap { position: absolute; left: 4dp; right: 4dp; bottom: -8dp; height: 6dp; border-radius: 3dp; background-color: #000000aa; }
.cp-fill { height: 100%; border-radius: 3dp; background-color: #ffc93c; }
.cp-fill.red { background-color: #ef5a4c; }
.cp-fill.blu { background-color: #6aa2d8; }
.cp-cappers {
	position: absolute; right: -8dp; top: -8dp;
	padding: 0 5dp;
	border-radius: 8dp;
	background-color: #ffc93c;
	color: #2a1a05;
	font-family: "TF2 Build";
	font-size: 13dp;
}
.koth-clock {
	width: 96dp; height: 40dp;
	text-align: center;
	font-family: "TF2 Build";
	font-size: 24dp;
	line-height: 40dp;
	color: #fff4e8;
}

#cart { width: 560dp; margin: 12dp auto 0 auto; }
.track {
	position: relative;
	height: 14dp;
	border-radius: 7dp;
	background-color: #120d0bd8;
	border: 2dp #000000aa;
}
.track-done { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 6dp; decorator: linear-gradient(to right, #2f5679, #6aa2d8); }
.track-cp {
	position: absolute; top: -5dp;
	width: 10dp; height: 20dp;
	margin-left: -5dp;
	border-radius: 3dp;
	background-color: #c8413b;
	border: 2dp #120d0a;
}
.track-cp.taken { background-color: #4a7fae; }
.cart-marker {
	position: absolute; top: -13dp;
	width: 36dp; height: 36dp;
	margin-left: -18dp;
	border-radius: 18dp;
	background-color: #4a7fae;
	border: 3dp #fff4e8;
	font-family: "TF2 Build";
	font-size: 20dp;
	line-height: 30dp;
	text-align: center;
	color: #fff4e8;
}
.cart-marker.back { background-color: #c8413b; }

#flags { justify-content: center; margin-top: 8dp; gap: 10dp; }
.flag {
	padding: 6dp 14dp;
	border-radius: 10dp;
	background-color: #120d0bd8;
	border-left: 5dp #c8413b;
	font-size: 15dp;
}
.flag.blu { border-left-color: #4a7fae; }
.flag-team { font-family: "TF2 Build"; margin-right: 8dp; }
.flag.stolen { background-color: #6e1f1bd8; }
.flag.blu.stolen { background-color: #23415cd8; }
.flag.stolen .flag-state, .flag.dropped .flag-state { color: #ffc93c; }
.flag-return { height: 4dp; margin-top: 4dp; border-radius: 2dp; background-color: #00000099; }

/* ------------------------------------------------------------ kill feed */
#killfeed { position: absolute; right: 28dp; top: 24dp; width: 640dp; text-align: right; }
.kill {
	display: block;
	margin-bottom: 5dp;
	animation: 0.25s cubic-out 1 inr;
}
.kill > * { vertical-align: middle; }
.kill {
	padding: 4dp 12dp;
	border-radius: 8dp;
	background-color: #120d0bcc;
	border: 1dp #00000000;
	white-space: nowrap;
	float: right;
	clear: right;
}
.kill.me { background-color: #f2e8d2ee; border-color: #ffc93c; }
.kill.crit { border-color: #ef5a4c; }
.kname { font-family: "TF2 Build"; font-size: 17dp; color: #ef6a5c; }
.kname.blu { color: #8fbde9; }
.kassist { font-size: 15dp; color: #ef6a5c; margin-left: 4dp; }
.kassist.blu { color: #8fbde9; }
.kill.me .kname { color: #a8352f; }
.kill.me .kname.blu { color: #2f5679; }
.kicon { height: 28dp; margin: 0 10dp; }

/* ------------------------------------------------------------ dead */
#dead { position: absolute; left: 0; right: 0; top: 64%; text-align: center; }
.dead-by { font-size: 20dp; color: #d8cdb4; font-effect: shadow(2dp 2dp #000000); }
.dead-in {
	font-family: "TF2 Build";
	font-size: 44dp;
	color: #ffc93c;
	text-transform: uppercase;
	font-effect: shadow(3dp 3dp #000000aa);
}

/* ------------------------------------------------------------ quests, notifications */
#tracker {
	position: absolute;
	left: 28dp; top: 260dp;
	width: 300dp;
	padding: 12dp 14dp;
	border-radius: 12dp;
	background-color: #0d0907a8;
	border-left: 4dp #ffc93c;
}
.tracker-title { font-family: "TF2 Build"; font-size: 15dp; text-transform: uppercase; color: #ffc93c; margin-bottom: 6dp; }
.track-q { margin-bottom: 8dp; }
.track-text { font-size: 14dp; line-height: 17dp; font-effect: shadow(1dp 1dp #000000); }
.track-q .bar { height: 6dp; margin-top: 3dp; }
.track-count { font-size: 12dp; color: #d8cdb4; margin-left: 8dp; }

#hud-toasts { position: absolute; right: 28dp; top: 250dp; width: 400dp; }
#hud-toasts .toast {
	display: flex; flex-direction: row; align-items: center; gap: 12dp;
	margin-bottom: 8dp; padding: 8dp 14dp 8dp 8dp;
	border-radius: 12dp; background-color: #17110ee8; border-left: 5dp #ffc93c;
	animation: 0.4s back-out 1 rise;
}
#hud-toasts .toast.quest { border-left-color: #8fd16a; }
#hud-toasts .toast-icon { width: 40dp; height: 40dp; border-radius: 6dp; }
#hud-toasts .toast-title { font-family: "TF2 Build"; font-size: 16dp; }
#hud-toasts .toast-body { font-size: 14dp; color: #d8cdb4; }

/* ------------------------------------------------------------ what is done to you */
#conds {
	position: absolute;
	left: 60dp; bottom: 162dp;
	width: 640dp;
	flex-wrap: wrap;
	gap: 6dp;
}
.cond, .disguise {
	display: flex; flex-direction: row; align-items: center;
	padding: 3dp 10dp;
	border-radius: 8dp;
	background-color: #120d0bd8;
	border-left: 3dp #8fd16a;
	font-family: "TF2 Build";
	font-size: 14dp;
	text-transform: uppercase;
	color: #e8f5dc;
	white-space: nowrap;
}
.cond.bad { border-left-color: #ef5a4c; color: #ffd8d2; animation: 0.7s sine-in-out infinite alternate cond-pulse; }
@keyframes cond-pulse { from { background-color: #120d0bd8; } to { background-color: #4a1612d8; } }
.cond.k-uber { border-left-color: #ffc93c; color: #ffe9a8; }
.cond.k-crits, .cond.k-minicrits { border-left-color: #ffc93c; color: #ffe9a8; }
.cond.k-burning { border-left-color: #ff8a3c; }
.cond.k-jarate { border-left-color: #e8d23c; }
.cond-icon { width: 20dp; height: 20dp; margin-right: 6dp; }
.disguise { border-left-color: #c8413b; color: #fff4e8; text-transform: none; font-family: "TF2 Secondary"; font-size: 15dp; }
.disguise.blu { border-left-color: #4a7fae; }
.disguise.busy { border-left-color: #b8ab92; color: #d8cdb4; }
.disguise-as { color: #b8ab92; margin-left: 8dp; }

/* ------------------------------------------------------------ the class's things */
#classbox {
	margin: 0 6dp 10dp 60dp;
	padding: 8dp 14dp 10dp 14dp;
	border-radius: 10dp;
	background-color: #120d0bd8;
	border: 1dp #6a544288;
}
.meter { margin-bottom: 6dp; }
.meter-label { font-family: "TF2 Build"; font-size: 15dp; color: #d8cdb4; text-transform: uppercase; }
.meter-count { font-family: "TF2 Build"; font-size: 18dp; color: #fff4e8; }
.meter-bar { height: 8dp; margin-top: 3dp; border-radius: 4dp; background-color: #00000099; border: 1dp #ffffff14; }
.meter-bar .fill { height: 100%; border-radius: 4dp; background-color: #d8cdb4; transition: width 0.15s; }
.meter.full .meter-bar .fill { background-color: #ffc93c; }
.meter.flash .meter-bar .fill { background-color: #ef5a4c; animation: 0.3s linear infinite alternate hp-throb; }
.meter-bar.power .fill { decorator: linear-gradient(to right, #c8413b, #ffc93c); transition: none; }
.class-nums { gap: 16dp; justify-content: flex-end; }
.class-num { font-size: 15dp; color: #b8ab92; }
.class-num .num { font-family: "TF2 Build"; font-size: 26dp; color: #fff4e8; margin-right: 4dp; }
.class-num.metal .num { color: #ffd76a; }
#uber.active .uber-fill { animation: 0.4s sine-in-out infinite alternate hp-throb; }
.uber-charges { font-family: "TF2 Build"; font-size: 17dp; color: #fff4e8; white-space: nowrap; }
#dead.up { top: 46%; }
.uber-resist {
	margin-left: 10dp; padding: 1dp 8dp; border-radius: 6dp;
	font-family: "TF2 Build"; font-size: 13dp; text-transform: uppercase;
	background-color: #ffffff18; color: #fff4e8;
}

/* ------------------------------------------------------------ buildings */
#buildings { position: absolute; left: 28dp; top: 24dp; width: 320dp; }
.bld {
	margin-bottom: 6dp;
	padding: 6dp 12dp 8dp 12dp;
	border-radius: 10dp;
	background-color: #120d0bd0;
	border-left: 4dp #8fd16a;
}
.bld.none { background-color: #120d0b80; border-left-color: #5a4e40; }
.bld.alert { border-left-color: #ffc93c; }
.bld.sapped { border-left-color: #ef5a4c; animation: 0.5s sine-in-out infinite alternate cond-pulse; }
.bld.building { border-left-color: #6aa2d8; }
.bld-head { gap: 8dp; }
.bld-name { font-family: "TF2 Build"; font-size: 15dp; text-transform: uppercase; color: #fff4e8; }
.bld.none .bld-name { color: #7d705e; }
.bld-level { font-size: 13dp; color: #b8ab92; }
.bld-alert { font-family: "TF2 Build"; font-size: 13dp; color: #ffc93c; text-transform: uppercase; }
.bld.sapped .bld-alert { color: #ef5a4c; }
.bld-kills { font-size: 13dp; color: #d8cdb4; }
.bld-off { font-size: 13dp; color: #7d705e; }
.bld-bars { margin-top: 3dp; }
.bld-stat { gap: 8dp; margin-top: 2dp; }
.bld-k { width: 74dp; font-size: 11dp; color: #8a7d68; text-transform: uppercase; white-space: nowrap; }
.bld-bar { height: 5dp; border-radius: 3dp; background-color: #00000099; }
.bld-bar .fill { height: 100%; border-radius: 3dp; }
.bld-bar.hp .fill { background-color: #8fd16a; }
.bld-bar.build .fill { background-color: #6aa2d8; }
.bld-bar.ammo .fill { background-color: #d8cdb4; }
.bld-bar.rockets .fill { background-color: #ff8a3c; }
.bld-bar.charge .fill { background-color: #b98cff; }
.bld-bar.upgrade .fill { background-color: #ffc93c; }
.bld-note { margin-top: 3dp; font-size: 12dp; color: #b8ab92; }
#tracker.low { top: 300dp; }

/* ------------------------------------------------------------ round start */
#restart { position: absolute; left: 0; right: 0; top: 30%; text-align: center; }
.restart-label { font-family: "TF2 Build"; font-size: 26dp; text-transform: uppercase; color: #d8cdb4; font-effect: shadow(2dp 2dp #000000); }
.restart-num { font-family: "TF2 Build"; font-size: 120dp; line-height: 124dp; color: #ffc93c; font-effect: shadow(4dp 4dp #000000aa); }

/* ------------------------------------------------------------ notices */
#notices { position: absolute; left: 50%; top: 150dp; width: 760dp; margin-left: -380dp; text-align: center; }
.notice {
	display: inline-block;
	margin: 0 auto 8dp auto;
	padding: 8dp 18dp;
	border-radius: 10dp;
	background-color: #17110ee8;
	border-bottom: 3dp #ffc93c;
	animation: 0.3s back-out 1 rise;
}
.notice-line { font-family: "TF2 Build"; font-size: 19dp; color: #fff4e8; }
.notice-line + .notice-line { font-family: "TF2 Secondary"; font-size: 16dp; color: #d8cdb4; }
.notice.k-stalemate, .notice.k-teamswitch { border-bottom-color: #ef5a4c; }
.notice.k-pause { border-bottom-color: #b8ab92; }

/* ------------------------------------------------------------ votes */
#votes { position: absolute; left: 28dp; top: 520dp; width: 360dp; }
.vote {
	margin-bottom: 8dp;
	padding: 10dp 14dp;
	border-radius: 10dp;
	background-color: #17110ee8;
	border-left: 4dp #ffc93c;
}
.vote.dim { opacity: 0.6; }
.vote.passed { border-left-color: #8fd16a; }
.vote.failed { border-left-color: #ef5a4c; }
.vote-head { font-family: "TF2 Build"; font-size: 15dp; text-transform: uppercase; color: #ffc93c; }
.vote.passed .vote-head { color: #8fd16a; }
.vote.failed .vote-head { color: #ef5a4c; }
.vote-issue { font-size: 16dp; line-height: 20dp; color: #fff4e8; margin-top: 2dp; }
.vote-opts { margin-top: 6dp; }
.vote-opt { font-size: 15dp; color: #d8cdb4; padding: 2dp 0; }
.vote-count { font-family: "TF2 Build"; color: #fff4e8; }
.vote-tally { gap: 8dp; margin-top: 6dp; font-family: "TF2 Build"; font-size: 16dp; }
.vote-bar { height: 8dp; border-radius: 4dp; background-color: #ef5a4c99; }
.vote-bar .fill { height: 100%; border-radius: 4dp; background-color: #8fd16a; }

/* ------------------------------------------------------------ chat */
#chat { position: absolute; left: 48dp; bottom: 206dp; width: 620dp; }
.chat-line {
	font-size: 17dp;
	line-height: 22dp;
	font-effect: shadow(1dp 1dp #000000);
	padding: 1dp 8dp;
	transition: opacity 1.5s;
}
.chat-line.fade { opacity: 0; }
#chat.open .chat-lines { max-height: 440dp; overflow: hidden; padding: 6dp 0; border-radius: 10dp 10dp 0 0; background-color: #0d0907b0; }
.chat-entry {
	pointer-events: auto;
	gap: 8dp;
	padding: 6dp 10dp;
	border-radius: 0 0 10dp 10dp;
	background-color: #17110ef0;
	border-top: 2dp #ffc93c;
}
.chat-mode { font-family: "TF2 Build"; font-size: 15dp; text-transform: uppercase; color: #ffc93c; }
.chat-mode.team { color: #8fd16a; }
.say-input { font-size: 18dp; color: #fff4e8; height: 26dp; cursor: text; }

/* ------------------------------------------------------------ dead, killer */
.dead-as { font-size: 18dp; color: #d8cdb4; margin-top: 2dp; font-effect: shadow(2dp 2dp #000000); }
#killer {
	position: absolute;
	left: 50%; bottom: 150dp;
	width: 560dp; margin-left: -280dp;
	padding: 14dp 18dp;
	border-radius: 14dp;
	decorator: linear-gradient(to bottom, #2a1f19f0, #120d0bf5);
	border-bottom: 4dp #c8413b;
	animation: 0.35s back-out 1 rise;
}
#killer.blu { border-bottom-color: #4a7fae; }
.killer-tag {
	display: inline-block; margin-bottom: 8dp; padding: 2dp 10dp; border-radius: 6dp;
	font-family: "TF2 Build"; font-size: 15dp; text-transform: uppercase;
	background-color: #ef5a4c; color: #fff4e8;
}
.killer-row { gap: 14dp; }
.killer-avatar, .killer-face { width: 72dp; height: 72dp; border-radius: 8dp; }
.killer-label { font-size: 14dp; color: #b8ab92; text-transform: uppercase; }
.killer-name { font-family: "TF2 Build"; font-size: 28dp; color: #fff4e8; }
.killer-cls { font-family: "TF2 Secondary"; font-size: 15dp; color: #b8ab92; margin-left: 6dp; }
.killer-hp { gap: 10dp; margin-top: 4dp; }
.killer-hp .bar { height: 8dp; }
.killer-hp .fill { decorator: linear-gradient(to right, #5f9a3a, #a8e07a); }
.killer-hp-num { font-family: "TF2 Build"; font-size: 16dp; color: #d8cdb4; }
.killer-weapon { gap: 10dp; margin-top: 10dp; padding-top: 8dp; border-top: 1dp #ffffff14; font-size: 16dp; color: #d8cdb4; }
.killer-weapon-icon { height: 44dp; }

/* ------------------------------------------------------------ spectating */
#spec { position: absolute; left: 0; right: 0; bottom: 34dp; text-align: center; }
.spec-card {
	width: 520dp; margin: 0 auto 10dp auto;
	padding: 10dp 16dp; gap: 14dp;
	border-radius: 12dp;
	background-color: #17110ee8;
	border-bottom: 4dp #c8413b;
	text-align: left;
}
.spec-card.blu { border-bottom-color: #4a7fae; }
.spec-avatar { width: 56dp; height: 56dp; border-radius: 8dp; }
.spec-name { font-family: "TF2 Build"; font-size: 24dp; color: #fff4e8; }
.spec-cls { font-size: 14dp; color: #b8ab92; }
.spec-hp { gap: 8dp; margin-top: 3dp; }
.spec-hp .bar { height: 7dp; }
.spec-hp .fill { decorator: linear-gradient(to right, #5f9a3a, #a8e07a); }
.spec-hp-num { font-family: "TF2 Build"; font-size: 15dp; color: #d8cdb4; }
.spec-keys { justify-content: center; gap: 22dp; font-size: 15dp; color: #d8cdb4; font-effect: shadow(1dp 1dp #000000); }
.spec-mode { font-family: "TF2 Build"; text-transform: uppercase; color: #ffc93c; }

/* ------------------------------------------------------------ end of a round */
#round {
	position: absolute;
	left: 50%; top: 150dp;
	width: 760dp; margin-left: -380dp;
	padding: 18dp 24dp 16dp 24dp;
	border-radius: 16dp;
	text-align: center;
	decorator: linear-gradient(to bottom, #2a1f19f2, #120d0bf5);
	border-top: 6dp #c8413b;
	animation: 0.45s back-out 1 rise;
}
#round.blu { border-top-color: #4a7fae; }
#round.draw { border-top-color: #b8ab92; }
.round-title { font-family: "TF2 Build"; font-size: 54dp; line-height: 58dp; text-transform: uppercase; color: #fff4e8; font-effect: shadow(3dp 3dp #000000aa); }
.round-reason { font-size: 19dp; color: #d8cdb4; margin-top: 4dp; }
.round-cappers { font-size: 15dp; color: #b8ab92; margin-top: 2dp; }
.round-score { justify-content: center; gap: 14dp; margin-top: 12dp; }
#round .score { font-family: "TF2 Build"; font-size: 44dp; line-height: 54dp; width: 90dp; border-radius: 10dp; }
#round .red-score { background-color: #c8413b; color: #fff4e8; }
#round .blu-score { background-color: #4a7fae; color: #f0f6ff; }
.round-top { margin-top: 14dp; text-align: left; }
.round-top-title { font-family: "TF2 Build"; font-size: 15dp; text-transform: uppercase; color: #ffc93c; margin-bottom: 4dp; }
.round-mvp { gap: 10dp; padding: 5dp 10dp; margin-bottom: 4dp; border-radius: 8dp; background-color: #c8413b2e; border-left: 4dp #c8413b; font-size: 16dp; }
.round-mvp.blu { background-color: #4a7fae2e; border-left-color: #4a7fae; }
.mvp-n { font-family: "TF2 Build"; color: #ffc93c; width: 18dp; }
.mvp-avatar { width: 28dp; height: 28dp; border-radius: 4dp; }
.mvp-name { font-family: "TF2 Build"; color: #fff4e8; }
.mvp-cls { color: #b8ab92; font-size: 14dp; }
.mvp-pts { font-family: "TF2 Build"; color: #fff4e8; }
.round-streak { margin-top: 8dp; font-size: 15dp; color: #d8cdb4; }

/* ------------------------------------------------------------ scoreboard */
#scores { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
#scores.live { pointer-events: auto; }
.scores-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #0d090770; }
.scores-panel {
	position: absolute;
	left: 50%; top: 96dp;
	width: 1480dp; margin-left: -740dp;
	padding: 18dp 22dp;
	border-radius: 18dp;
	decorator: linear-gradient(to bottom, #2a1f19f4, #120d0bf8);
	border: 1dp #6a5442;
}
.scores-banner {
	margin: -18dp -22dp 14dp -22dp;
	padding: 10dp 0;
	border-radius: 17dp 17dp 0 0;
	text-align: center;
	font-family: "TF2 Build"; font-size: 46dp; text-transform: uppercase; color: #fff4e8;
	background-color: #c8413b;
}
.scores-banner.blu { background-color: #4a7fae; }
.scores-banner.draw { background-color: #5a4e40; }
.scores-top { margin-bottom: 12dp; }
.scores-map { font-family: "TF2 Build"; font-size: 28dp; text-transform: uppercase; color: #fff4e8; }
.scores-sub { font-size: 15dp; color: #b8ab92; }
.scores-hint { font-size: 14dp; color: #7d705e; }
.scores-cols { align-items: flex-start; gap: 20dp; }
.scores-team { border-radius: 12dp; background-color: #00000040; padding-bottom: 6dp; }
.team-head { padding: 8dp 14dp; border-radius: 12dp 12dp 0 0; gap: 12dp; }
.scores-team.blu .team-head { decorator: linear-gradient(to right, #2f5679, #4a7fae); }
.scores-team.red .team-head { decorator: linear-gradient(to right, #8e2a26, #c8413b); }
.team-name { font-family: "TF2 Build"; font-size: 26dp; color: #fff4e8; }
.team-count { font-size: 14dp; color: #ffffffb0; }
.team-total { font-family: "TF2 Build"; font-size: 34dp; color: #fff4e8; }
.col-head { padding: 6dp 14dp 4dp 14dp; font-size: 13dp; color: #7d705e; text-transform: uppercase; }
.col-head .c-name { padding-left: 70dp; }
.c-num { width: 72dp; text-align: right; white-space: nowrap; }
.c-ping { width: 64dp; text-align: right; }
.prow { padding: 3dp 14dp; gap: 8dp; font-size: 16dp; color: #ece3cb; }
.prow:nth-child(odd) { background-color: #ffffff06; }
.prow.me { background-color: #ffc93c24; }
.prow.dead { color: #7d705e; }
#scores.live .prow { cursor: pointer; }
#scores.live .prow:hover { background-color: #ffc93c38; }
.p-avatar { width: 28dp; height: 28dp; border-radius: 4dp; }
.p-avatar.none { background-color: #ffffff10; }
.p-cls { width: 26dp; height: 26dp; }
.p-cls.none { width: 26dp; }
.p-name { font-family: "TF2 Build"; font-size: 16dp; white-space: nowrap; overflow: hidden; }
.prow.dead .p-name { color: #8a7d68; }
.p-score { font-family: "TF2 Build"; color: #fff4e8; }
.p-tag { padding: 0 6dp; border-radius: 5dp; font-size: 12dp; background-color: #ffffff14; color: #d8cdb4; white-space: nowrap; }
.p-tag.nemesis { background-color: #ef5a4c; color: #fff4e8; }
.p-tag.dominated { background-color: #8fd16a; color: #1a2a10; }
.scores-spec { margin-top: 10dp; font-size: 14dp; color: #b8ab92; }
.scores-me { margin-top: 12dp; padding-top: 10dp; border-top: 1dp #ffffff14; gap: 22dp; flex-wrap: wrap; }
.stat { font-size: 13dp; color: #b8ab92; text-transform: uppercase; }
.stat .v { font-family: "TF2 Build"; font-size: 22dp; color: #fff4e8; margin-right: 6dp; text-transform: none; }

/* ------------------------------------------------------------ class menus */
#classmenu {
	position: absolute;
	left: 50%; bottom: 190dp;
	width: 760dp; margin-left: -380dp;
	padding: 12dp 16dp;
	border-radius: 14dp;
	decorator: linear-gradient(to bottom, #2a1f19f0, #120d0bf5);
	border-bottom: 4dp #ffc93c;
	animation: 0.2s cubic-out 1 rise;
}
#classmenu.k-destroy { border-bottom-color: #ef5a4c; }
#classmenu.k-disguise { width: 900dp; margin-left: -450dp; }
.cm-head { margin-bottom: 8dp; gap: 10dp; }
.cm-title { font-family: "TF2 Build"; font-size: 20dp; text-transform: uppercase; color: #fff4e8; }
.cm-metal { font-family: "TF2 Build"; font-size: 18dp; color: #ffd76a; }
.cm-team { font-family: "TF2 Build"; font-size: 16dp; padding: 1dp 10dp; border-radius: 6dp; background-color: #c8413b; color: #fff4e8; }
.cm-team.blu { background-color: #4a7fae; }
.cm-slots { gap: 10dp; }
.cm-slot {
	position: relative;
	flex: 1 1 0;
	padding: 10dp 10dp 8dp 10dp;
	border-radius: 10dp;
	background-color: #ffffff0c;
	border: 2dp #ffffff10;
	text-align: center;
}
.cm-slot.s-ready { border-color: #8fd16a; }
.cm-slot.s-built { border-color: #ef5a4c; }
.cm-slot.s-short, .cm-slot.s-none { opacity: 0.6; }
.cm-slot.s-off { opacity: 0.3; }
.cm-slot.selected { border-color: #ffc93c; background-color: #ffc93c1e; }
.cm-slot.dim { opacity: 0.35; }
.cm-key {
	position: absolute; left: 6dp; top: 6dp;
	width: 22dp; height: 22dp; line-height: 22dp; border-radius: 5dp;
	font-family: "TF2 Build"; font-size: 14dp; background-color: #000000aa; color: #ece3cb;
}
.cm-name { font-family: "TF2 Build"; font-size: 16dp; text-transform: uppercase; color: #fff4e8; margin-top: 18dp; }
.cm-slot.cls .cm-name { margin-top: 2dp; font-size: 13dp; }
.cm-note { font-size: 13dp; color: #b8ab92; margin-top: 2dp; }
.cm-slot.s-ready .cm-note { color: #ffd76a; }
.cm-face { width: 64dp; height: 64dp; margin: 6dp auto 0 auto; }
.cm-hint { margin-top: 8dp; font-size: 13dp; color: #7d705e; text-align: center; }
