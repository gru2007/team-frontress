<rml>
<!--
	Always on top of the current screen: the top bar, the play button, the
	queue, notifications and modals. The body lets clicks through; only the
	pieces with .hit take them. In a match (ui.in_game) the main menu's
	pieces step aside for the pause and class screens.
-->
<head>
	<title>Shell</title>
	<link type="text/rcss" href="style/base.rcss"/>
	<link type="text/rcss" href="style/shell.rcss"/>
</head>
<body id="shell">
<div class="root" data-model="fr">

	<!-- Top bar -->
	<div id="topbar" class="hit" data-if="!ui.in_game">
		<div id="logo" data-event-click="nav('home')" sfx="tab">
			<div class="logo-small">Team</div>
			<div class="logo-big">Frontress</div>
		</div>

		<div id="tabs">
			<div class="tab" sfx="tab" data-class-active="ui.screen == 'home'" data-event-click="nav('home')">#fui_tab_home</div>
			<div class="tab" sfx="tab" data-class-active="ui.screen == 'play'" data-event-click="nav('play')">#fui_tab_play</div>
			<div class="tab" sfx="tab" data-class-active="ui.screen == 'war'" data-event-click="nav('war')">#fui_tab_war<span class="live-dot" data-if="war.battles > 0"></span></div>
			<div class="tab" sfx="tab" data-class-active="ui.screen == 'quests'" data-event-click="nav('quests')">#fui_tab_quests<span class="count-badge" data-if="quests.total > 0 && quests.done < quests.total">{{ quests.total - quests.done }}</span></div>
			<div class="tab" sfx="tab" data-class-active="ui.screen == 'clan'" data-event-click="nav('clan')">#fui_tab_clan<span class="count-badge" data-if="clan.invites.size > 0 && !clan.has">{{ clan.invites.size }}</span></div>
			<div class="tab" sfx="tab" data-class-active="ui.screen == 'locker'" data-event-click="nav('locker')">#fui_tab_locker</div>
			<div class="tab" sfx="tab" data-class-active="ui.screen == 'career'" data-event-click="nav('career')">#fui_tab_career</div>
		</div>

		<div class="spacer"></div>

		<div id="status">
			<div class="row status-line">
				<span class="gc-dot" data-class-online="app.gc == 'online'" data-class-connecting="app.gc == 'connecting'"></span>
				<span class="online-count">{{ app.online | thousands }}</span>
				<span class="dim small">&nbsp;#fui_online</span>
			</div>
			<div class="dimmer tiny" data-if="app.gc == 'online'">{{ app.matches_live }} #fui_matches_live</div>
			<div class="bad tiny" data-if="app.gc == 'offline'">#fui_gc_offline</div>
			<div class="dim tiny" data-if="app.gc == 'connecting'">#fui_gc_connecting</div>
		</div>

		<div id="player-chip" sfx="" data-event-click="nav('career')">
			<div class="chip-avatar">
				<img class="avatar" data-if="player.avatar != ''" data-attr-src="player.avatar"/>
				<div class="avatar blank" data-if="player.avatar == ''"></div>
				<div class="chip-level">{{ player.level }}</div>
			</div>
			<div class="who">
				<div class="name"><span class="clan-tag chip-tag" data-if="player.tag != ''">{{ player.tag }}</span>{{ player.name }}</div>
				<div class="bar xp"><div class="fill" data-style-width="(player.xp_frac * 100) + '%'"></div></div>
			</div>
		</div>

		<div class="icon-button party-button" sfx="" data-event-click="cmd('open_invites')">#fui_party_group · {{ party.count }}<span class="count-badge" data-if="invites.incoming.size + invites.requests.size > 0">{{ invites.incoming.size + invites.requests.size }}</span></div>
		<div class="icon-button support-button" sfx="" data-class-active="ui.screen == 'support'" data-event-click="nav('support')"><div class="sup-gem"></div><span>#fui_tab_support</span></div>
		<div class="icon-button" sfx="" data-event-click="cmd('open_settings')">#fui_settings</div>
		<div class="icon-button quit" sfx="" data-event-click="set('ui.modal', 'quit')">#fui_quit</div>
	</div>

	<!-- Notifications -->
	<div id="toasts">
		<div class="toast" data-for="t : toasts" data-attr-class="'toast k-' + t.kind">
			<img class="toast-icon" data-if="t.icon != ''" data-attr-src="t.icon"/>
			<div class="col grow">
				<div class="toast-title">{{ t.title }}</div>
				<div class="toast-body">{{ t.body }}</div>
			</div>
		</div>
	</div>

	<!-- Queue status, under the top bar on every screen. -->
	<div id="queue-strip" data-if="queue.state == 'searching' && !ui.in_game">
		<div class="queue-pill hit in0">
			<div class="radar"><div class="radar-ring"></div><div class="radar-dot"></div></div>
			<div class="col">
				<div class="title small">#fui_searching</div>
				<div class="dim tiny">{{ ('fui_mode_' + queue.mode) | t }} · {{ queue.players }}/{{ queue.needed }} #fui_players_found</div>
				<div class="dim tiny" data-if="app.no_servers">#fui_queue_no_servers</div>
			</div>
			<div class="queue-time">{{ queue.seconds | clock }}</div>
			<div class="button ghost small-button" sfx="" data-event-click="cmd('unqueue')">#fui_cancel</div>
		</div>
	</div>

	<!-- The play button: Fortnite's corner, TF2's colours. -->
	<div id="play-cluster" class="hit inr" data-if="!ui.in_game && (ui.screen == 'home' || ui.screen == 'play')">
		<div id="mode-card" sfx="" data-event-click="nav('play')">
			<div data-for="m : modes">
				<div class="mode-inner" data-if="m.id == ui.mode">
					<img class="mode-thumb" data-attr-src="'tex:' + m.image"/>
					<div class="col grow">
						<div class="dimmer tiny upper">#fui_choose_mode</div>
						<div class="title mode-name">{{ m.name | t }}</div>
						<div class="dim small">{{ m.size }}</div>
					</div>
					<div class="change">#fui_change ›</div>
				</div>
			</div>
		</div>
		<div class="play-glow" data-if="queue.state == 'idle'"></div>
		<div class="play-button sheen-box" sfx="play" data-if="queue.state == 'idle'" data-event-click="cmd('queue', ui.mode)">
			<div class="sheen"></div>
			<div class="label">#fui_play</div>
			<div class="play-hint">{{ party.count }}/{{ party.max }} · {{ ('fui_mode_' + ui.mode) | t }}</div>
		</div>
		<div class="play-button searching" sfx="" data-if="queue.state == 'searching'" data-event-click="cmd('unqueue')">
			<div class="label">#fui_cancel</div>
			<div class="sub">{{ queue.seconds | clock }}</div>
		</div>
	</div>

	<div id="queue-strip" data-if="queue.state == 'preparing' && !ui.in_game">
		<div class="queue-pill hit in0"><span class="pulse"></span><div class="title small">#fui_queue_preparing</div>
			<div class="button ghost small-button" sfx="" data-event-click="cmd('decline')">#fui_cancel</div>
		</div>
	</div>

	<!-- Match found -->
	<div class="modal-dim hit" data-if="queue.state == 'found' || queue.state == 'joining'">
		<div class="modal match-found">
			<div class="mf-image" data-style-decorator="'image(tex:' + queue.map_image + ' cover center top)'"></div>
			<div class="mf-body">
				<div class="gold title mf-title outline">#fui_match_found</div>
				<h2 class="shadow">{{ queue.map }}</h2>
				<div class="dim">{{ ('fui_mode_' + queue.mode) | t }}</div>
				<div class="row mf-buttons" data-if="queue.state == 'found'">
					<div class="button primary big" sfx="play" data-event-click="cmd('accept')">#fui_accept</div>
					<div class="button ghost" sfx="" data-event-click="cmd('decline')">#fui_decline</div>
				</div>
				<div class="dim mf-joining" data-if="queue.state == 'joining'">
					<span class="pulse"></span> #fui_joining
					<div class="button ghost" sfx="" data-event-click="cmd('decline')">#fui_cancel</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Settings: the game's options, the HUD, everything else the classic
	     menu had -->
	<div class="modal-dim hit" data-if="ui.modal == 'settings'">
		<div class="modal settings-modal">
			<div class="row">
				<h2 class="shadow grow">#fui_settings</h2>
				<div class="icon-button" sfx="" data-event-click="set('ui.modal', '')">#fui_close</div>
			</div>
			<div class="set-grid">
				<div class="set-tile" sfx="" data-event-click="cmd('classic', 'options')">
					<div class="set-title">#fui_set_options</div><div class="dim tiny">#fui_set_options_d</div>
				</div>
				<div class="set-tile" sfx="" data-event-click="cmd('classic', 'advanced')">
					<div class="set-title">#fui_set_advanced</div><div class="dim tiny">#fui_set_advanced_d</div>
				</div>
				<div class="set-tile" sfx="" data-event-click="cmd('classic', 'achievements')">
					<div class="set-title">#fui_set_achievements</div><div class="dim tiny">#fui_set_achievements_d</div>
				</div>
				<div class="set-tile" sfx="" data-event-click="cmd('classic', 'workshop')">
					<div class="set-title">#fui_set_workshop</div><div class="dim tiny">#fui_set_workshop_d</div>
				</div>
				<div class="set-tile" sfx="" data-event-click="cmd('classic', 'servers')">
					<div class="set-title">#fui_set_servers</div><div class="dim tiny">#fui_set_servers_d</div>
				</div>
				<div class="set-tile" sfx="" data-event-click="cmd('classic', 'create')">
					<div class="set-title">#fui_set_create</div><div class="dim tiny">#fui_set_create_d</div>
				</div>
				<div class="set-tile" sfx="" data-event-click="cmd('classic', 'console')">
					<div class="set-title">#fui_set_console</div><div class="dim tiny">#fui_set_console_d</div>
				</div>

			</div>
			<div class="set-tile" sfx="" data-event-click="cmd('toggle_menu_3d')">
				<div class="set-title">#fui_set_menu_3d</div>
				<div class="dim tiny">{{ (settings.menu_3d ? 'fui_menu_3d_on' : 'fui_menu_3d_off') | t }}</div>
			</div>
			<div class="panel-title hud-title">#fui_set_hud <span class="sub">#fui_set_hud_d</span></div>
			<div class="row hud-styles">
				<div class="hud-style" data-for="h : settings.huds" data-class-active="h == settings.hud_style"
					data-event-click="cmd('hud_style', h)" sfx="">
					<div class="set-title">{{ ('#fui_hud_style_' + h) | t }}</div>
					<div class="dimmer tiny">{{ h }}</div>
				</div>
			</div>
		</div>
	</div>

	<div class="modal-dim hit" data-if="ui.modal == 'invite'">
		<div class="modal settings-modal party-modal">
			<div class="row">
				<h2 class="shadow grow">#fui_party_group · {{ party.count }}/{{ party.max }}</h2>
				<div class="icon-button" sfx="" data-event-click="set('ui.modal', '')">#fui_close</div>
			</div>
			<div class="party-columns">
				<div class="party-column">
					<div class="panel-title">#fui_party_members</div>
					<div class="row invite-row" data-for="p : party.members">
						<div class="col grow"><span>{{ p.name }}</span><span class="tiny dim" data-if="p.leader">#fui_party_leader</span></div>
						<div class="button danger small-button" data-if="party.leader &amp;&amp; !p.me" data-event-click="cmd('kick_member', p.id)">#fui_party_kick</div>
					</div>
					<div class="button danger small-button" data-if="party.count > 1" data-event-click="cmd('leave_party')">#fui_party_leave</div>
					<div class="panel-title invite-heading" data-if="invites.incoming.size > 0">#fui_party_invites</div>
					<div class="row invite-row" data-for="p : invites.incoming">
						<span class="grow">{{ p.name }}</span>
						<div class="button primary small-button" data-event-click="cmd('accept_invite', p.id)">#fui_accept</div>
						<div class="button ghost small-button" data-event-click="cmd('decline_invite', p.id)">#fui_decline</div>
					</div>
					<div class="panel-title invite-heading" data-if="party.leader &amp;&amp; invites.requests.size > 0">#fui_party_requests</div>
					<div data-if="party.leader">
						<div class="row invite-row" data-for="p : invites.requests">
							<span class="grow">{{ p.name }}</span>
							<div class="button primary small-button" data-event-click="cmd('accept_request', p.id)">#fui_accept</div>
							<div class="button ghost small-button" data-event-click="cmd('cancel_invite', p.id)">#fui_decline</div>
						</div>
					</div>
					<div class="panel-title invite-heading" data-if="invites.outgoing.size > 0">#fui_party_pending</div>
					<div class="row invite-row" data-for="p : invites.outgoing">
						<span class="grow">{{ p.name }}</span>
						<div class="button ghost small-button" data-if="party.leader" data-event-click="cmd('cancel_invite', p.id)">#fui_cancel</div>
					</div>
				</div>
				<div class="party-column" data-if="party.leader">
					<div class="panel-title">#fui_party_friends</div>
					<div class="dim small">#fui_party_search</div>
					<input class="text invite-search" type="text" maxlength="64" data-value="invites.search" data-attr-placeholder="'fui_party_search' | t"/>
					<div class="invite-list">
						<div class="row invite-row" data-for="p : invites.friends">
							<div class="col grow"><span>{{ p.name }}</span><span class="tiny dim" data-if="p.online">#fui_online</span><span class="tiny dim" data-if="!p.online">#fui_party_offline</span></div>
							<div class="button ghost small-button" data-if="party.count + invites.outgoing.size + invites.requests.size &lt; party.max" data-event-click="cmd('invite_player', p.id)">#fui_soc_invite</div>
						</div>
						<div class="dim small" data-if="invites.friends.size == 0">#fui_invite_empty</div>
					</div>
				</div>
				<div class="party-column dim" data-if="!party.leader">#fui_party_leader_invites</div>
			</div>
		</div>
	</div>

	<div class="modal-dim hit" data-if="ui.modal == 'leave_party' || ui.modal == 'kick_member'">
		<div class="modal quit-modal">
			<h2 data-if="ui.modal == 'leave_party'">#fui_party_leave</h2>
			<h2 data-if="ui.modal == 'kick_member'">#fui_party_kick</h2>
			<p class="dim" data-if="ui.modal == 'leave_party'">#fui_party_leave_body</p>
			<p class="dim" data-if="ui.modal == 'kick_member'">{{ 'fui_party_kick_body' | t(ui.kick_name) }}</p>
			<div class="row mf-buttons">
				<div class="button danger" data-if="ui.modal == 'leave_party'" data-event-click="cmd('confirm_leave_party')">#fui_party_leave</div>
				<div class="button danger" data-if="ui.modal == 'kick_member'" data-event-click="cmd('confirm_kick', ui.kick_target)">#fui_party_kick</div>
				<div class="button primary" data-event-click="set('ui.modal', 'invite')">#fui_cancel</div>
			</div>
		</div>
	</div>

	<div class="modal-dim hit" data-if="ui.modal == 'leave_match'">
		<div class="modal quit-modal">
			<h2>#fui_disconnect</h2>
			<p class="dim">#fui_leave_match_body</p>
			<div class="row mf-buttons">
				<div class="button danger" data-event-click="cmd('confirm_disconnect')">#fui_disconnect</div>
				<div class="button primary" data-event-click="set('ui.modal', '')">#fui_cancel</div>
			</div>
		</div>
	</div>

	<!--
		Report a player. Who (those who killed you first), why, what exactly,
		and your own words. It goes to the moderators next to what Easy
		Anti-Cheat recorded about the player, and to EOS Player Reports.
	-->
	<div class="modal-dim hit" data-if="ui.modal == 'report'">
		<div class="modal report-modal">
			<div class="row report-head">
				<div class="report-shield"></div>
				<div class="col grow">
					<h2>#fui_report_title</h2>
					<div class="dim small">#fui_report_sub</div>
				</div>
				<div class="icon-button" data-event-click="cmd('report_done')">#fui_close</div>
			</div>

			<div class="row report-body" data-if="!report.sent">
				<div class="col report-who">
					<div class="report-label">#fui_report_who</div>
					<div class="report-list">
						<div class="row report-player" data-for="p : report.players" data-class-active="report.target == p.id" data-class-done="p.reported" data-class-red="p.team == 'red'" data-class-blu="p.team == 'blu'" data-event-click="cmd('report_pick', p.id)">
							<div class="team-bar"></div>
							<img class="avatar report-avatar" data-if="p.avatar != ''" data-attr-src="p.avatar"/>
							<div class="avatar report-avatar blank" data-if="p.avatar == ''"></div>
							<div class="col grow report-pmain">
								<div class="report-pname">{{ p.name }}</div>
								<div class="tiny dim"><span data-if="p.cls != ''">{{ ('fui_class_' + p.cls) | t }} · </span>{{ 'fui_report_points' | t(p.score) }}</div>
							</div>
							<div class="kill-badge" data-if="p.kills > 0" data-class-last="p.last_killer">{{ 'fui_report_killed_you' | t(p.kills) }}</div>
							<div class="tiny dim" data-if="p.reported">#fui_report_already</div>
						</div>
						<p class="dim" data-if="report.players.size == 0">#fui_report_empty</p>
					</div>
				</div>

				<div class="col grow report-form">
					<div class="report-label">#fui_report_why</div>
					<div class="reason-grid">
						<div class="reason-tile" data-class-active="report.reason == 1" data-event-click="cmd('report_reason', 1)"><div class="reason-title">#fui_report_cheating</div><div class="tiny dim">#fui_report_cheating_sub</div></div>
						<div class="reason-tile" data-class-active="report.reason == 3" data-event-click="cmd('report_reason', 3)"><div class="reason-title">#fui_report_harassment</div><div class="tiny dim">#fui_report_harassment_sub</div></div>
						<div class="reason-tile" data-class-active="report.reason == 4" data-event-click="cmd('report_reason', 4)"><div class="reason-title">#fui_report_griefing</div><div class="tiny dim">#fui_report_griefing_sub</div></div>
						<div class="reason-tile" data-class-active="report.reason == 2" data-event-click="cmd('report_reason', 2)"><div class="reason-title">#fui_report_idle</div><div class="tiny dim">#fui_report_idle_sub</div></div>
					</div>

					<div data-if="report.reason == 1">
						<div class="report-label">#fui_report_what</div>
						<div class="report-chips">
							<div class="chip report-chip" data-class-active="report.d.aimbot" data-event-click="cmd('report_detail', 'aimbot')">#fui_report_d_aimbot</div>
							<div class="chip report-chip" data-class-active="report.d.wallhack" data-event-click="cmd('report_detail', 'wallhack')">#fui_report_d_wallhack</div>
							<div class="chip report-chip" data-class-active="report.d.triggerbot" data-event-click="cmd('report_detail', 'triggerbot')">#fui_report_d_triggerbot</div>
							<div class="chip report-chip" data-class-active="report.d.movement" data-event-click="cmd('report_detail', 'movement')">#fui_report_d_movement</div>
							<div class="chip report-chip" data-class-active="report.d.exploit" data-event-click="cmd('report_detail', 'exploit')">#fui_report_d_exploit</div>
						</div>
					</div>
					<div data-if="report.reason == 3">
						<div class="report-label">#fui_report_where</div>
						<div class="report-chips">
							<div class="chip report-chip" data-class-active="report.d.chat" data-event-click="cmd('report_detail', 'chat')">#fui_report_d_chat</div>
							<div class="chip report-chip" data-class-active="report.d.voice" data-event-click="cmd('report_detail', 'voice')">#fui_report_d_voice</div>
							<div class="chip report-chip" data-class-active="report.d.name" data-event-click="cmd('report_detail', 'name')">#fui_report_d_name</div>
						</div>
					</div>

					<div class="report-label">#fui_report_comment</div>
					<input class="text report-comment" type="text" maxlength="200" data-value="report.comment" data-attr-placeholder="'fui_report_comment_hint' | t"/>
				</div>
			</div>

			<div class="row report-foot" data-if="!report.sent">
				<div class="row grow eac-note" data-class-on="report.eac">
					<div class="eac-mark"></div>
					<div class="tiny" data-if="report.eac">#fui_report_eac_on</div>
					<div class="tiny" data-if="!report.eac">#fui_report_eac_off</div>
				</div>
				<div class="dim" data-if="report.pending">#fui_report_sending</div>
				<div class="button primary" data-if="!report.pending &amp;&amp; report.target != '' &amp;&amp; report.reason > 0" data-event-click="cmd('send_report')">#fui_report_send</div>
				<div class="button primary disabled" data-if="!report.pending &amp;&amp; (report.target == '' || report.reason == 0)">#fui_report_send</div>
			</div>

			<div class="report-sent" data-if="report.sent">
				<div class="report-shield big"></div>
				<h2>#fui_report_sent_title</h2>
				<p class="dim">{{ 'fui_report_sent_body' | t(report.target_name) }}</p>
				<div class="row mf-buttons">
					<div class="button ghost" data-if="report.can_mute &amp;&amp; !report.muted" data-event-click="cmd('report_mute')">#fui_report_mute</div>
					<div class="button ghost" data-if="report.can_mute &amp;&amp; report.muted" data-event-click="cmd('report_mute')">#fui_report_unmute</div>
					<div class="button primary" data-event-click="cmd('report_done')">#fui_report_done</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Quit -->
	<div class="modal-dim hit" data-if="ui.modal == 'quit'">
		<div class="modal quit-modal">
			<h2 class="shadow">#fui_quit_title</h2>
			<p class="dim">#fui_quit_body</p>
			<div class="row mf-buttons">
				<div class="button danger" sfx="" data-event-click="cmd('quit')">#fui_quit_yes</div>
				<div class="button primary" sfx="" data-event-click="set('ui.modal', '')">#fui_quit_no</div>
			</div>
		</div>
	</div>
</div>
</body>
</rml>
