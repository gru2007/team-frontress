// Every value the documents read, with the value it has before the game says
// otherwise. A top-level key that is not here is invisible to the documents.
// The game fills these in src/game/client/tf/frontress/fui_tf.cpp; the
// previewer from tools/fui-preview/mock.json.
{
	// Local UI state. Documents write it with set()/toggle()/nav().
	"ui": {
		"screen": "home",
		"class": "soldier",		// locker: class shown
		"slot": "primary",		// locker: slot being filled
		"pick": -1,				// locker: index into locker.items under the cursor
		"mode": "casual",		// play: mode the play button queues for
		"front": "",			// war: the sector shown in the side panel
		"war_hover": "",		// war: the sector under the cursor
		"modal": "",			// "", "quit", "invite"
		"in_game": false,		// in a match: the pause, class and HUD screens
		"class_hover": "soldier",	// class select: the class shown
		"chat_draft": "",			// the chat line being typed
		"say_draft": "",			// in a match: the chat line being typed
		"leave_lobby": "",
		"party_target": "",
		"kick_target": "",
		"kick_name": ""
	},
	// world: a map is behind the menu (the game's background level or the
	// match). preview: tools/fui-preview, which draws 2D stand-ins where the
	// game puts 3D characters.
	"app": { "gc": "offline", "online": 0, "version": "", "matches_live": 0, "no_servers": false, "world": false, "preview": false, "models": true },
	// tag: clan tag; sup: supports the developers (sup_monthly: subscribes)
	"player": { "name": "", "avatar": "", "level": 1, "xp": 0, "xp_next": 1, "xp_frac": 0, "side": "red", "rank": "", "title": "", "tag": "", "sup": false, "sup_monthly": false },
	// members: { key ("me" / "member:<id>", the 3D look), name, avatar, level,
	// leader, me, class, slot (lobby position 0-4), has_look }
	"party": { "max": 6, "count": 1, "leader": true, "members": [], "empty": [] },
	"invites": { "incoming": [], "friends": [], "outgoing": [], "requests": [], "search": "" },
	// The report dialog. players: { id, name, avatar, team (red/blu/spec), cls,
	// score, kills (times they killed you on this map), last_killer, reported };
	// d: the detail chips (EDetail), eac: logged in to EOS (the report also
	// reaches Easy Anti-Cheat), sent: the coordinator saved it.
	"report": { "players": [], "target": "", "target_name": "", "reason": 0, "comment": "", "pending": false, "sent": false, "eac": false, "can_mute": false, "muted": false,
		"d": { "aimbot": false, "wallhack": false, "triggerbot": false, "movement": false, "exploit": false, "chat": false, "voice": false, "name": false } },
	// state: idle | searching | preparing | found | joining | live
	"queue": { "state": "idle", "mode": "", "seconds": 0, "players": 0, "needed": 0, "map": "", "map_image": "" },
	"modes": [],
	// The region picker (src/game/client/tf/frontress/fui_servers.cpp): pick is
	// tf_mm_region ("auto" or a region id); list { id, name, ms (best ping to a
	// server there, -1 if none), ok (reached within max_ms), measured, on }.
	"region": { "pick": "auto", "max_ms": 200, "list": [] },
	"maps": [],
	// The coordinator's GET /v1/war as it is (services/gc/internal/gc/warview.go):
	// fronts are sectors { id, name, icon, hq, x, y, owner, frontline, front,
	// attacker, from, stage, stages, mode, map, image, ... }, links roads
	// { a, b, side }, ops the operations { front, node, name, attacker,
	// defender, from_name, stage, stages, plan, kind, next, prev, mode, ... },
	// top the sector to send people to, events { kind, side, name, stage_kind, ago }.
	"war": { "name": "", "day": 0, "days": 0, "red": 0.5, "red_fronts": 0, "blu_fronts": 0, "battles": 0, "soldiers": 0, "servers": 0, "servers_free": 0,
		"fronts": [], "links": [], "ops": [], "top": "", "hot": "", "order_xp": 0, "live": [], "events": [] },
	// The in-match HUD (src/game/client/tf/frontress/fui_hud.cpp), for
	// resource/fui/huds/*. Numbers are -1 when there is nothing to show.
	// points: { owner, capping, frac, cappers, locked, blocked }
	// cart: { progress 0..1, speed (-1 back, 0..3), team }
	// flags: { team, status (home|stolen|dropped), return 0..1 }
	// kills: { killer, killer_team, assist, victim, victim_team, icon, crit, me }
	"hud": {
		"visible": true, "alive": false, "class": "", "team": "red",
		"health": 0, "max": 1, "frac": 0, "overheal": 0, "low": false,
		"weapon": "", "weapon_icon": "", "clip": -1, "reserve": -1, "clip_max": 0, "clip_low": false,
		"charge": -1, "charge_ready": false, "respawn": -1, "killed_by": "",
		"mode": "", "timer": -1, "setup": false, "overtime": false, "waiting": false, "restart": -1,
		"score_red": 0, "score_blu": 0, "koth_red": -1, "koth_blu": -1,
		"points": [], "cart": { "progress": -1, "speed": 0, "team": "blu" }, "flags": [], "kills": [],
		// What the class carries (fui_hud.cpp, from the stock panels' logic).
		// conds: { id, icon, bad } (burning, bleeding, resists, buffs...);
		// disguise: a spy's; meters: the item meters { label, frac, count,
		// percent, bars, flash, streak }; stickies, power (a weapon charging
		// 0..1), metal: -1 when not yours; charge_kind (uber, kritz, quickfix,
		// vaccinator), charge_resist, charges (the Vaccinator's), charge_active.
		// buildings: an engineer's four slots { kind (sentry, dispenser,
		// entrance, exit), built, level, mini, health, building, progress,
		// carried, sapped, disabled, alert (sapper, ammo, health), upgrade,
		// ammo, rockets, kills, assists, charge, used }, -1 where it has none.
		"conds": [], "disguise": { "on": false, "disguising": false, "class": "", "team": "", "name": "", "weapon": "" },
		"meters": [], "stickies": -1, "power": -1, "metal": -1, "metal_max": 200,
		"charge_kind": "", "charge_resist": "", "charges": -1, "charge_active": false,
		"buildings": [], "next_class": "",
		// The overlays (fui_hud_overlay.cpp). scores: the scoreboard { shown,
		// summary (the match is over), mouse (the cursor is on), winner, mine,
		// red / blu { score, count, players[ { idx, id, name, team, cls, score,
		// kills, deaths, damage, healing, alive, me, bot, ping, doms, streak,
		// avatar, muted, rivalry (nemesis, dominated) } ] }, spec[], time_left,
		// me { your round's stats } }.
		"scores": { "shown": false, "summary": false, "mouse": false, "winner": "", "mine": false, "time_left": -1,
			"red": { "score": 0, "count": 0, "players": [] }, "blu": { "score": 0, "count": 0, "players": [] }, "spec": [],
			"me": { "kills": 0, "deaths": 0, "assists": 0, "destruction": 0, "captures": 0, "defenses": 0, "dominations": 0, "revenge": 0,
				"healing": 0, "invulns": 0, "teleports": 0, "headshots": 0, "backstabs": 0, "bonus": 0, "damage": 0 } },
		// round: the end of a round { shown, winner, mine, complete, reason,
		// cappers, score_red, score_blu, top[ { name, team, cls, points, avatar } ],
		// streak_name, streak }.
		"round": { "shown": false, "winner": "", "mine": false, "complete": false, "reason": "", "cappers": "", "score_red": 0, "score_blu": 0,
			"top": [], "streak_name": "", "streak": 0 },
		// killer: who killed you, over the freeze frame; spec: whom you watch.
		"killer": { "shown": false, "self": false, "object": "", "name": "", "team": "", "cls": "", "avatar": "", "health": 0, "max": 1, "frac": 0,
			"weapon": "", "weapon_icon": "", "rivalry": "" },
		"spec": { "shown": false, "mode": "", "team_spec": false,
			"target": { "on": false, "object": "", "name": "", "team": "", "cls": "", "avatar": "", "health": 0, "max": 1, "frac": 0 } },
		// notices: { kind, lines[] } (the game's own notices); votes: { header,
		// issue, result (passed, failed), result_text, voted, input, yesno,
		// needed, options[ { label, count } ] }; chat: { open, mode (all, team,
		// party), lines[ { fade, segs[ { t, c (a colour, "" plain) } ] } ] }.
		"notices": [], "votes": [], "chat": { "open": false, "mode": "all", "lines": [] },
		// menu: an engineer's build / destroy menu or a spy's disguise menu
		// (fui_ingame.cpp) { shown, kind (build, destroy, disguise), metal, team,
		// group, simple, slots[ { key, kind, state, cost } | { key, cls, group, selected } ] }.
		// state: build: ready, built, short, off; destroy: built, none, off.
		"menu": { "shown": false, "kind": "", "metal": 0, "team": "red", "group": -1, "simple": false, "slots": [] }
	},
	// The settings window: the HUDs installed (resource/fui/huds) and the one in use.
	"settings": { "menu_3d": true, "hud_style": "auto", "huds": [ "auto" ] },
	"locker": {
		"slot_label": "", "inventory_ready": false, "inventory_retrying": false, "inventory_count": 0,
		"classes": [
			{ "id": "scout", "name": "#fui_class_scout" }, { "id": "soldier", "name": "#fui_class_soldier" },
			{ "id": "pyro", "name": "#fui_class_pyro" }, { "id": "demoman", "name": "#fui_class_demoman" },
			{ "id": "heavy", "name": "#fui_class_heavy" }, { "id": "engineer", "name": "#fui_class_engineer" },
			{ "id": "medic", "name": "#fui_class_medic" }, { "id": "sniper", "name": "#fui_class_sniper" },
			{ "id": "spy", "name": "#fui_class_spy" }
		],
		// slot entries: { id, name, item } where item is like a locker.items entry or null
		"equipped": [],
		// items that fit ui.class and ui.slot: { index, name, type, icon, quality, level, equipped }
		"view": [],
		"detail": {},
		"filter": "all",
		"count": 0
	},
	"career": { "hours": 0, "matches": 0, "wins": 0, "mvp": 0, "ratings": [], "classes": [], "history": [] },
	"results": { "result": "", "map": "", "image": "", "mode": "", "score_red": 0, "score_blu": 0, "duration": 0, "front": "", "front_before": 0, "front_after": 0,
		"xp_total": 0, "level_before": 0, "level_after": 0, "frac_before": 0, "frac_after": 0, "rating": 0, "delta": 0, "xp": [], "mvps": [],
		// result: win | loss | draw; pending: the coordinator has not said what it was worth yet
		"pending": false },
	// The coordinator's social side (src/game/client/tf/frontress/fui_social.cpp).
	// tab: global | clan | party | online. view: the open tab's chat lines
	// { id, ch, name, tag, gold, sup, text, sys, key, a1..a4, kind, time, me }
	// (a system line says key | t(a1, a2, ...)). online: { total, menu, queue,
	// match, lfg, clans, players: [{ id, name, tag, gold, sup, level, status
	// (menu|queue|match), mode, map, lfg, note, party, me }] }.
	"social": { "tab": "global", "view": [], "unread_clan": 0, "unread_party": 0, "has_clan": false, "has_party": false,
		"lfg": false, "lfg_note": "", "online": { "total": 0, "menu": 0, "queue": 0, "match": 0, "lfg": 0, "clans": 0, "players": [] } },
	// The clan (services/gc/internal/gc/clan.go): has, c (the clan: id, name,
	// tag, motto, emblem (a class), color, open, level, xp, xp_from, xp_to,
	// frac, count, cap, online, wins, battles, banner, gold, role, members[],
	// perks[{ id, level, on }], contract{ kind, target, progress, frac, paid,
	// left, on, clan_xp, member_xp }, order, order_name, order_xp, bonus,
	// week_xp, can_invite, invited[{ id, name, ago, online }], rank, clans,
	// gap_up, gap_top, near[] (clan cards with rank, me, gap), max, next{ level,
	// perks[], xp_left, wins, together, eta }, next_perk{ id, level, xp_left,
	// wins, together, eta }, earn{ match, win, together, contract }, daily_xp),
	// officer, leader, invites[] and top[] (clan cards with rank, me, week_xp).
	// cands: who the invite dialog offers (fui_social.cpp): [{ id, name,
	// level, status (menu, queue, match, steam, offline), friend, invited }].
	"clan": { "loaded": false, "has": false, "officer": false, "leader": false, "c": {}, "invites": [], "top": [], "cands": [] },
	// The create / settings form; search: the invite dialog's filter.
	"clanform": { "name": "", "tag": "", "motto": "", "emblem": "soldier", "color": "red", "open": true, "search": "" },
	// The support tab (services/gc/internal/gc/support.go): offered,
	// available, loading, busy, sandbox, currency, once[] and monthly[] tiers
	// { tier, kind, amount, price }, me { supporter, monthly, donations, since },
	// wall[] { name, kind, ago }, count, subscribers, anon, result (opening,
	// pending, thanks, cancelled, error), error, problem.
	"support": { "show_wall": true, "simulated": false, "offered": false, "available": false, "loading": false, "busy": false, "sandbox": false, "currency": "",
		"once": [], "monthly": [], "me": { "supporter": false, "monthly": false, "donations": 0, "since": 0 }, "wall": [],
		"count": 0, "subscribers": 0, "anon": false, "result": "", "error": "", "problem": "" },
	// From the coordinator: pushed after every match (social "quests"), and
	// polled from GET /v1/player/<id>/quests (fui_tf.cpp). Each quest:
	// { key, kind, class, per, target, amount, text_key, progress, frac, xp,
	// reward, reward_n, tier (1-3, 4 weekly), slot, last (added by the last
	// match), can_reroll, done, weekly, photo }. bonus: the day's { xp,
	// reward, reward_n, paid, streak, streak_every, streak_next,
	// streak_reward }; rewards: unclaimed { total, crate, rare_crate,
	// recent[{ kind, n, src, quest, ago }] }. stale: the copy is old.
	"quests": { "daily": [], "weekly": [], "daily_left": 0, "weekly_left": 0, "done": 0, "total": 0,
		"rerolls_left": 0, "rerolling": false, "loaded": false, "stale": false,
		"bonus": { "xp": 0, "reward": "", "reward_n": 0, "paid": false, "streak": 0, "streak_every": 7, "streak_next": 7, "streak_reward": "" },
		"rewards": { "total": 0, "crate": 0, "rare_crate": 0, "recent": [] } },
	// The match being played, for the pause screen. mode_name: "Control
	// Points"..., goal: the map's goal for your team, role: attack | defend | "".
	// war: a war battle { active, sector, stage, stages, kind, attacker,
	// attacking, order, conditions[] }.
	"match": { "active": false, "map": "", "map_id": "", "image": "", "red": 0, "blu": 0, "team": "none", "class": "", "official": false, "matched": false,
		"mode_name": "", "goal": "", "role": "",
		"war": { "active": false, "sector": "", "stage": 0, "stages": 0, "kind": "", "attacker": "", "attacking": false, "order": false, "conditions": [] } },
	// Class select: whose team, and the class played now.
	"classsel": { "team": "red", "current": "" },
	// Calling a vote (the server's issues, fui_ingame.cpp): issues { id, label,
	// active, param (map, player, mission, "") }, maps / missions { id, name },
	// players { idx, name, cls, avatar }; issue, kind, param, reason: the choice.
	"votesetup": { "loading": false, "enabled": true, "issues": [], "maps": [], "missions": [], "players": [],
		"issue": "", "kind": "", "param": "", "reason": "other" },
	// Muting: players { idx, name, team, avatar, muted, talking }, all_comms.
	"mute": { "players": [], "all_comms": false },
	// Team select: each side as you see it { count, score, closed (would
	// unbalance) }, the team you are on (red, blu, spectate, ""), arena (play or
	// watch only).
	"teamsel": { "arena": false, "current": "", "can_close": false, "spectate_ok": true,
		"red": { "count": 0, "score": 0, "closed": false }, "blu": { "count": 0, "score": 0, "closed": false } },
	// Notifications: { kind (quest, party, clan, support, error), title, body, icon (a texture source) }
	"toasts": []
}
