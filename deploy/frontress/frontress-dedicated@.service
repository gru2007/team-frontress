# Each instance owns a separate payload and cfg tree at /srv/frontress/<id>.
# Install as /etc/systemd/system/frontress-dedicated@.service.
[Unit]
Description=Team Frontress dedicated server %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=frontress
Group=frontress
WorkingDirectory=/srv/frontress/%i
EnvironmentFile=/etc/frontress/%i.env
ExecStart=/srv/frontress/%i/start_dedicated_tc2.sh +map itemtest +ip 0.0.0.0 -port ${GAME_PORT}
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
