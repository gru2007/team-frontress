# GC application environment in Coolify. No website, MongoDB or serveme here.
# Both keys below are publisher keys for Playtest 5147520.
STEAM_API_KEY=
STEAM_PUBLISHER_KEY=
# Independent shared secret for private website administration calls.
GC_ADMIN_KEY=
# Dedicated admission key, at least 16 characters; generate with openssl rand -hex 32.
GC_SERVER_KEY=
GC_DATA_DIR=/data
GOMEMLIMIT=256MiB
GOMAXPROCS=1
# Optional: a full config JSON, without publisher keys. Do not combine with GC_CONFIG_FILE.
# GC_CONFIG_JSON=
# Or mount a config file in Coolify and set its container path.
# GC_CONFIG_FILE=/data/gc.json
