GC_HOST=gc.example.org
PORTAL_HOST=matches.example.org
STEAM_API_KEY=
# Steam publisher key for Playtest 5147520 with Microtransactions permission, only passed to GC.
STEAM_PUBLISHER_KEY=
# Existing tf2pickup configuration. Reuse the current database and secrets.
MONGODB_URI=
PORTAL_STEAM_API_KEY=
SUPER_USER=
KEY_STORE_PASSPHRASE=
TF2PICKUP_GAME_SERVER_SECRET=
# Optional extra allowlist for existing tf2pickup admins/super-users.
FRONTRESS_ADMIN_STEAM_IDS=
# Generate an independent private GC API key: openssl rand -hex 32
GC_ADMIN_KEY=
# Optional absolute path if the repositories are not siblings.
# TF2PICKUP_SOURCE=/srv/frontress/tf2pickup-frontress
