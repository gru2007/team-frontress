#!/bin/bash
#
# Downloads only the Team Fortress 2 depot the launcher is missing. This does
# not change Steam's platform or install a second full copy of the game.

set -u

case "${1:-}" in
	content)
		COMMAND='download_depot 440 441'
		REQUIREMENT='Team Fortress 2 content depot 441'
		;;
	engine)
		COMMAND='download_depot 440 232251'
		REQUIREMENT='Team Fortress 2 engine depot 232251'
		;;
	*)
		printf 'usage: %s content|engine\n' "$0" >&2
		exit 2
		;;
esac

printf '%s' "${COMMAND}" | /usr/bin/pbcopy
/usr/bin/open 'steam://open/console'

TC2_STEAM_COMMAND="${COMMAND}" TC2_STEAM_REQUIREMENT="${REQUIREMENT}" \
	/usr/bin/osascript <<'APPLESCRIPT' >/dev/null
set theCommand to system attribute "TC2_STEAM_COMMAND"
set theRequirement to system attribute "TC2_STEAM_REQUIREMENT"
display dialog theRequirement & " is required." & return & return & ¬
	"The depot command is already in your clipboard. Paste it into the Steam Console, wait for the download to complete, then launch Team Frontress again." & return & return & ¬
	theCommand ¬
	with title "Team Frontress" buttons {"OK"} default button 1
APPLESCRIPT
