$Macro OUTBINNAME "tc2"

$Conditional "MOD_LAUNCHER" "1"

$Include "launcher_main.vpc"

$Configuration
{
	$Compiler
	{
		// Only used when nothing set SteamAppId in the environment: Steam sets it for
		// the app it launched, so a copy from either the playtest or the main app
		// initialises as the app it was started from. This is what a build run by
		// hand, outside Steam, attaches to.
		// The demo branch builds the Team Frontress Demo app.
		$PreprocessorDefinitions	"$BASE;MOD_APPID=5260620" // Team Frontress Demo.
	}
}

$Project "Launcher Main (TC2)"
{
    $Folder "Resource Files" [$WINDOWS]
    {
        $File   "launcher_main_tc2.rc"
        $File   "res\tc2.ico"
    }
}