// Steam rich presence tokens for Team Frontress (appID 5147520).
//
// This file is not read by the game. It has to be uploaded on the Steamworks
// partner site (App Admin -> Community -> Rich Presence Localization) before
// anything appears in the friends list: Steam resolves "steam_display" against
// what the app has uploaded, not against anything the client ships. The
// in-game friends panel reads the "status" key instead, which is why that has
// worked all along while the Steam client showed nothing.
//
// %state% and %matchgrouploc% are the keys ClientModeTFNormal::
// UpdateSteamRichPresence sets. matchgrouploc is a suffix, not a sentence --
// "Casual", "Competitive6v6", "BootCamp", "MannUp", "SpecialEvent" -- so it is
// resolved through a token of its own rather than printed raw.
"lang"
{
	"Language"	"english"
	"Tokens"
	{
		"#Frontress_RichPresence_Display"					"{#Frontress_RichPresence_State_%state%}"

		"#Frontress_RichPresence_State_MainMenu"				"At the Main Menu"
		"#Frontress_RichPresence_State_SearchingGeneric"			"Searching for a Match"
		"#Frontress_RichPresence_State_SearchingMatchGroup"		"Searching for {#Frontress_RichPresence_MatchGroup_%matchgrouploc%}"
		"#Frontress_RichPresence_State_PlayingMatchGroup"			"Playing {#Frontress_RichPresence_MatchGroup_%matchgrouploc%} on %currentmap%"
		"#Frontress_RichPresence_State_LoadingMatchGroup"			"Joining {#Frontress_RichPresence_MatchGroup_%matchgrouploc%}"
		"#Frontress_RichPresence_State_PlayingGeneric"			"Playing on %currentmap%"
		"#Frontress_RichPresence_State_LoadingGeneric"			"Joining a match"
		"#Frontress_RichPresence_State_PlayingCommunity"			"Playing on %currentmap%"
		"#Frontress_RichPresence_State_LoadingCommunity"			"Joining a community server"

		"#Frontress_RichPresence_MatchGroup_Casual"				"Casual"
		"#Frontress_RichPresence_MatchGroup_Competitive6v6"		"Competitive 6v6"
		"#Frontress_RichPresence_MatchGroup_BootCamp"			"Boot Camp"
		"#Frontress_RichPresence_MatchGroup_MannUp"				"Mann Up"
		"#Frontress_RichPresence_MatchGroup_SpecialEvent"			"a Special Event"
	}
}
